diff --git a/model/attn_processor.py b/model/attn_processor.py
index 7e79f32..b7ba154 100644
--- a/model/attn_processor.py
+++ b/model/attn_processor.py
@@ -2,6 +2,29 @@ from torch.nn import functional as F
 import torch
 # from flash_attn import flash_attn_func
 
+
+# MPS has no memory-efficient attention kernel, so the full (q x k) score matrix is
+# materialized; at 768x1024 with concatenated condition this is ~18 GB. Split the work
+# per batch item and along the query axis to bound peak memory.
+MAX_SCORE_ELEMENTS = 2 ** 28
+
+
+def chunked_sdpa(query, key, value, attention_mask=None):
+    if query.device.type == "cuda":
+        return F.scaled_dot_product_attention(query, key, value, attn_mask=attention_mask)
+    b, h, q_len, _ = query.shape
+    k_len = key.shape[-2]
+    if h * q_len * k_len <= MAX_SCORE_ELEMENTS:
+        return F.scaled_dot_product_attention(query, key, value, attn_mask=attention_mask)
+    chunk = max(1, MAX_SCORE_ELEMENTS // (h * k_len))
+    out = torch.empty_like(query)
+    for i in range(b):
+        for s in range(0, q_len, chunk):
+            m = None if attention_mask is None else attention_mask[i:i + 1, :, s:s + chunk]
+            out[i:i + 1, :, s:s + chunk] = F.scaled_dot_product_attention(
+                query[i:i + 1, :, s:s + chunk], key[i:i + 1], value[i:i + 1], attn_mask=m)
+    return out
+
 class SkipAttnProcessor(torch.nn.Module):
     def __init__(self, *args, **kwargs) -> None:
         super().__init__()
